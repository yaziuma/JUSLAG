[Unit]
Description=Capture JUSLAG JP opening bars
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/JUSLAG
Environment=PYTHONPATH=src
ExecStart=%h/projects/JUSLAG/.venv/bin/python scripts/ops/capture_intraday.py --period 1d --db data/intraday/prices.sqlite --snapshot-dir data/opening_bars
TimeoutStartSec=5min

[Install]
WantedBy=default.target
