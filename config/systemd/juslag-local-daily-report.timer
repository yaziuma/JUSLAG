[Unit]
Description=Generate local JUSLAG report before the 08:55 entry deadline

[Timer]
OnCalendar=Mon..Fri *-*-* 06:00:00
OnCalendar=Mon..Fri *-*-* 07:00:00
OnCalendar=Mon..Fri *-*-* 08:00:00
OnCalendar=Mon..Fri *-*-* 08:40:00
AccuracySec=10s
RandomizedDelaySec=0
Persistent=false
Unit=juslag-local-daily-report.service

[Install]
WantedBy=timers.target
