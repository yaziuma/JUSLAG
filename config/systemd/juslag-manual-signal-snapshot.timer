[Unit]
Description=Retry the lightweight JUSLAG signal snapshot before entry cutoff

[Timer]
OnCalendar=Mon..Fri *-*-* 08:32:00
OnCalendar=Mon..Fri *-*-* 08:36:00
OnCalendar=Mon..Fri *-*-* 08:40:00
AccuracySec=5s
RandomizedDelaySec=0
Persistent=false
Unit=juslag-manual-signal-snapshot.service

[Install]
WantedBy=timers.target
