[Unit]
Description=Retry the lightweight JUSLAG signal snapshot before entry cutoff

[Timer]
OnCalendar=Mon..Fri *-*-* 08:35:00
OnCalendar=Mon..Fri *-*-* 08:42:00
OnCalendar=Mon..Fri *-*-* 08:48:00
AccuracySec=5s
RandomizedDelaySec=0
Persistent=false
Unit=juslag-manual-signal-snapshot.service

[Install]
WantedBy=timers.target
